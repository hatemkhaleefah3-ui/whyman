{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "whyman-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "RESEND_FROM": "Whyman <onboarding@resend.dev>",
    "ADMIN_BOOTSTRAP_EMAIL": "hatemkhalifa101@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whyman-db",
      "database_id": "c79436f3-e445-4ce2-b41c-9782f63bf1b5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "whyman-files"
    }
  ],
  "env": {
    "production": {
      "name": "whyman",
      "vars": {
        "APP_ORIGIN": "https://whyman.pages.dev",
        "RESEND_FROM": "Whyman <onboarding@resend.dev>",
        "ADMIN_BOOTSTRAP_EMAIL": "hatemkhalifa101@gmail.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "whyman-db",
          "database_id": "c79436f3-e445-4ce2-b41c-9782f63bf1b5",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "whyman-files"
        }
      ]
    }
  }
}
